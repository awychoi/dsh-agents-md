{
  "name": "dsh-agents-md",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AGENTS.md editor for DeepSeek Harness: a right-sidebar markdown editor for workspace agent instructions.",
  "author": "awychoi",
  "license": "MIT",
  "homepage": "https://github.com/awychoi/dsh-agents-md#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awychoi/dsh-agents-md.git"
  },
  "bugs": {
    "url": "https://github.com/awychoi/dsh-agents-md/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agents-md",
    "markdown",
    "editor",
    "instructions"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test test/host.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "gitignore.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/preview.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
